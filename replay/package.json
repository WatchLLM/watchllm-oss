    "better-sqlite3": "^11.9.1",
    "express": "^4.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "postcss": "^8.5.24",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.16"
  }
